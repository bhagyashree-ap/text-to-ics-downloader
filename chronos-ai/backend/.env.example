# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Qwen provider ----
# QWEN_PROVIDER=mock              -> deterministic mock, NO credentials needed (default)
# QWEN_PROVIDER=openai_compatible -> Qwen served on an OpenAI-compatible server (e.g. vLLM)
QWEN_PROVIDER=mock
QWEN_MODEL=Qwen/Qwen2.5-14B-Instruct
QWEN_API_BASE_URL=
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2
QWEN_MAX_INPUT_CHARACTERS=20000

# ---- Pipeline behavior ----
DEFAULT_TIMEZONE=UTC
DEFAULT_EVENT_DURATION_MINUTES=60

# ---- gRPC (MVP: one server hosts all services) ----
GRPC_PORT=50051
GRPC_DEADLINE_SECONDS=20
GRPC_INPUT_PROCESSING_TARGET=localhost:50051
GRPC_AI_EXTRACTION_TARGET=localhost:50051
GRPC_DATE_NORMALIZATION_TARGET=localhost:50051
GRPC_EVENT_VALIDATION_TARGET=localhost:50051
GRPC_CLARIFICATION_TARGET=localhost:50051
GRPC_REMINDER_TARGET=localhost:50051
GRPC_ICS_GENERATION_TARGET=localhost:50051
GRPC_ARTIFACT_TARGET=localhost:50051

# ---- Artifacts ----
ARTIFACT_STORAGE_PATH=/tmp/chronos-artifacts
ARTIFACT_TTL_SECONDS=3600

# ---- Limits ----
MAX_TEXT_CHARACTERS=50000
MAX_UPLOAD_BYTES=10485760
