# --- LLM (Qwen3 on vLLM, OpenAI-compatible) ---------------------------------
# Leave LLM_BASE_URL empty to run with the built-in rules-based fallback.
# Set it to your vLLM server to use Qwen3.
LLM_BASE_URL=
# vLLM ignores the key, but the OpenAI client requires a non-empty value.
LLM_API_KEY=EMPTY
# The served model name, OR a registered LoRA adapter name (e.g. "text2ics").
LLM_MODEL=Qwen/Qwen3-14B
LLM_TIMEOUT_SECONDS=30

# --- App behavior ------------------------------------------------------------
DEFAULT_DURATION_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
